@using OppKanban.Datamodels
@inject IConfigSettings AppConfig

<article data-theme="light">
    @if (_stageCounts.All(stage => stage.Count == 0))
    {
        <p>No opportunities found.</p>
    }
    else
    {
        <ApexChart TItem="StageCount" Title="Opportunities by stage">
            <ApexPointSeries TItem="StageCount"
                            Items="_stageCounts"
                            Name="Opportunities"
                            SeriesType="SeriesType.Pie"
                            XValue="stage => stage.Name"
                            YValue="stage => stage.Count" />
        </ApexChart>
    }
</article>

@code {
	[Parameter]
    public IEnumerable<OppView> Opportunities { get; set; } = Enumerable.Empty<OppView>();

	private readonly List<StageCount> _stageCounts = new();

	protected override void OnParametersSet()
	{
		_stageCounts.Clear();
		var opportunities = Opportunities.ToList();

			_stageCounts.AddRange(StageHelper.GetAllStages(AppConfig).Select(stage => new StageCount(
				StageHelper.GetStageName(stage),
				opportunities.Count(opportunity => StageHelper.IsSameStage(opportunity.GetStageName(), stage)))));
	}

	private sealed record StageCount(string Name, int Count);
}