@using OppKanban.Datamodels
@using ApexCharts

<article data-theme="light">
    @if (_data.Count == 0)
    {
        <p>No quantity at risk data available.</p>
    }
    else
    {
        <ApexChart TItem="RevenueAtRiskData" Title="Quantity at Risk by Feature Request" Options="_chartOptions">
            <ApexPointSeries TItem="RevenueAtRiskData"
                            Items="_data"
                            Name="Count"
                            SeriesType="SeriesType.Donut"
                            XValue="item => item.Feature"
                            YValue="item => (decimal)item.Quantity" />
        </ApexChart>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<OppView> Opportunities { get; set; } = Enumerable.Empty<OppView>();

    private List<RevenueAtRiskData> _data = new();
    private ApexChartOptions<RevenueAtRiskData> _chartOptions = new();

    protected override void OnInitialized()
    {
        _chartOptions = new ApexChartOptions<RevenueAtRiskData>
        {
            Chart = new Chart { Type = ChartType.Donut }
        };
    }

    protected override void OnParametersSet()
    {
        _data = Opportunities
            .Where(o => o.OppMetadata?.Feedback != null)
            .SelectMany(o => o.OppMetadata!.Feedback
                .Select(f => new { o.OppDetails.Err, f.Id }))
            .GroupBy(x => x.Id)
            .Select(g => new RevenueAtRiskData
            {
                Feature = g.Key,
                Quantity = g.Count()
            })
            .ToList();
    }
}
