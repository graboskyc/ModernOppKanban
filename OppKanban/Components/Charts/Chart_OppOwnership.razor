@using OppKanban.Datamodels

<article data-theme="light">
    @if (_ownerCounts.Count == 0)
    {
        <p>No opportunities found.</p>
    }
    else
    {
        <ApexChart TItem="OwnerCount" Title="@_chartTitle" Options="_options">
            @foreach (var saGroup in _ownerCounts.GroupBy(owner => owner.Sa).OrderBy(group => group.Key))
            {
                <ApexPointSeries TItem="OwnerCount"
                                 Items="saGroup.ToList()"
                                 Name="@saGroup.Key"
                                 SeriesType="SeriesType.Treemap"
                                 XValue="owner => owner.Owner"
                                 YValue="owner => owner.Count" />
            }
        </ApexChart>
    }
</article>

@code {
    [Parameter]
    public IEnumerable<OppView> Opportunities { get; set; } = Enumerable.Empty<OppView>();

    [Parameter]
    public bool ExcludeClosed { get; set; }

    private readonly List<OwnerCount> _ownerCounts = new();

    private readonly ApexChartOptions<OwnerCount> _options = new()
    {
        Chart = new Chart { Height = 420 },
        Legend = new Legend { Show = true }
    };

    string _chartTitle = "All Opportunities by SA and Account Owner";

    protected override void OnParametersSet()
    {
        _ownerCounts.Clear();
        var opportunities = Opportunities
                .Where(opportunity => opportunity.OppDetails is not null);

        if (ExcludeClosed)
        {
            opportunities = opportunities.Where(opportunity =>
                opportunity.GetStageEnum() is not OpportunityStage.ClosedWon and not OpportunityStage.ClosedLost);
            _chartTitle = "Open Opportunities by SA and Account Owner";
        }

        _ownerCounts.AddRange(opportunities
                .GroupBy(opportunity => new
                {
                    Sa = DisplayName(opportunity.OppDetails!.PrimarySA, "Unassigned SA"),
                    Owner = DisplayName(opportunity.OppDetails!.OpportunityOwner, "Unassigned owner")
                })
                .OrderBy(group => group.Key.Sa)
                .ThenBy(group => group.Key.Owner)
                .Select(group => new OwnerCount(group.Key.Sa, group.Key.Owner, group.Count())));
    }

    private static string DisplayName(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private sealed record OwnerCount(string Sa, string Owner, int Count);
}
