@rendermode InteractiveServer
@using OppKanban.Datamodels
@using MongoDB.Driver
@using MongoDB.Bson
@using MongoDB.Bson.Serialization.Attributes
@inject IMongoCollection<OppView> OppCollection

<div>
	<h1>@_cutoffDays-Day Outlook</h1>

	@if (!string.IsNullOrWhiteSpace(_errorMessage))
	{
		<p class="text-danger">@_errorMessage</p>
	}
	else if (_isLoading)
	{
		<p>Loading upcoming events...</p>
	}
	else if (_events.Count == 0)
	{
		<p>No upcoming events found.</p>
	}
	else
	{
		<EventsTimeline Events="_events" OnEventClick="OpenOpportunityAsync" />
	}

	@if (!string.IsNullOrWhiteSpace(_openErrorMessage))
	{
		<p class="text-danger">@_openErrorMessage</p>
	}

	@if (_selectedOpportunity is not null)
	{
		<OppDetailsModal Opportunity="_selectedOpportunity" OnClose="CloseOpportunityModal" />
	}
</div>
@code {
	private readonly List<EventEntry> _events = new();
	private readonly Dictionary<EventEntry, string> _eventOpportunityIds = new();
	private OppView? _selectedOpportunity;
	private bool _isLoading = true;
	private string _errorMessage = string.Empty;
	private string _openErrorMessage = string.Empty;
	
	const int _cutoffDays = 90;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var now = DateTime.UtcNow;
			var cutoff = now.AddDays(_cutoffDays);

			var results = await OppCollection.Aggregate()
				.Unwind<OppView, UpcomingEventResult>(x => x.OppMetadata!.Events)
				.Match(Builders<UpcomingEventResult>.Filter.And(
					Builders<UpcomingEventResult>.Filter.Gt(x => x.OppMetadata!.Events!.EventDate, now),
					Builders<UpcomingEventResult>.Filter.Lt(x => x.OppMetadata!.Events!.EventDate, cutoff)))
				.ToListAsync();

			foreach (var result in results.Where(r => r.OppDetails is not null && r.OppMetadata?.Events is not null))
			{
				var evt = new EventEntry
				{
					EventName = $"{result.OppDetails!.OppName}: {result.OppMetadata!.Events!.EventName}",
					EventDate = result.OppMetadata!.Events!.EventDate
				};

				_events.Add(evt);
				_eventOpportunityIds.Add(evt, result.OppDetails!.Id);
			}
		}
		catch (Exception ex)
		{
			_errorMessage = $"Unable to load upcoming events: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task OpenOpportunityAsync(EventEntry evt)
	{
		if (!_eventOpportunityIds.TryGetValue(evt, out var opportunityId))
		{
			_openErrorMessage = "Unable to open opportunity: event information is unavailable.";
			return;
		}

		try
		{
			_selectedOpportunity = await OppCollection
				.Find(opp => opp.OppDetails.Id == opportunityId)
				.FirstOrDefaultAsync();

			if (_selectedOpportunity is null)
			{
				_openErrorMessage = "Unable to open opportunity: opportunity not found.";
			}
			else
			{
				_openErrorMessage = string.Empty;
			}
		}
		catch (Exception ex)
		{
			_openErrorMessage = $"Unable to open opportunity: {ex.Message}";
		}
	}

	private void CloseOpportunityModal()
	{
		_selectedOpportunity = null;
	}

	// shape of a document after $unwind collapses oppMetadata.events into a single subdocument
	[BsonIgnoreExtraElements]
	private sealed class UpcomingEventResult
	{
		[BsonElement("oppDetails")]
		public OppBase? OppDetails { get; set; }
		[BsonElement("oppMetadata")]
		public UpcomingOppMetadata? OppMetadata { get; set; }
	}

	[BsonIgnoreExtraElements]
	private sealed class UpcomingOppMetadata
	{
		[BsonElement("events")]
		public EventEntry? Events { get; set; }
	}
}
