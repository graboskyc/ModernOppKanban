@inherits LayoutComponentBase

<div class="container">
    <article>
        <nav data-theme="dark">
            <ul>
                <li><img height="32" src="/favicon.png" style="height: 32px !important;" /></li>
            </ul>
            <ul>
                <li><a href="/Home">Home</a></li>
                <li><a href="/Analytics">Analytics</a></li>
                <li><a href="/SAs">SAs</a></li>
                <li><button type="button" class="secondary notes-toggle" aria-expanded="@_isNotesOpen" @onclick="ToggleNotes">Notes</button></li>
                <li>
                     <details class="dropdown">
                        <summary>
                        Import
                        </summary>
                        <ul dir="rtl">
                            <a href="/Import">Opps</a>
                            <a href="/ImportTime">Time Tracking</a>
                            <a href="/Config">Config</a>
                        </ul>
                    </details>
                </li>
            </ul>
        </nav>
    </article>

    <article>
        @Body
    </article>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<NotesPanel IsOpen="_isNotesOpen" IsOpenChanged="SetNotesPanelState" />

@code {
    private bool _isNotesOpen;

    private void ToggleNotes() => _isNotesOpen = !_isNotesOpen;

    private Task SetNotesPanelState(bool isOpen)
    {
        _isNotesOpen = isOpen;
        return Task.CompletedTask;
    }
}
