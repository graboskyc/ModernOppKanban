@page "/Analytics"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using OppKanban.Datamodels
@using OppKanban.Components.Shared
@using MongoDB.Driver
@inject IMongoCollection<OppView> OppCollection
@inject IJSRuntime JS
@inject IConfigSettings AppConfig

<PageTitle>Analytics</PageTitle>

<h1>Analytics</h1>

<CloseYearFilter Quarters="CloseQuarters" SelectedQuarters="_selectedCloseQuarters" SelectedQuartersChanged="HandleCloseQuartersChangedAsync" />

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
	<p class="text-danger">@_errorMessage</p>
}
else if (_isLoading)
{
	<p>Loading analytics...</p>
}
else if (_opportunities.Count == 0)
{
	<p>No opportunities found.</p>
}
else
{
	<div class="grid">
		<Chart_OppOwnership @key="OwnershipChartKey(true)" Opportunities="FilteredOpportunities" ExcludeClosed="true" />
		<Chart_OppOwnership @key="OwnershipChartKey(false)" Opportunities="FilteredOpportunities" ExcludeClosed="false" />
	</div>

	<div class="grid">
		<Chart_WinLoss @key="WinLossChartKey" Opportunities="FilteredOpportunities" />
		<Chart_RevAtRisk Opportunities="FilteredOpportunities" />
		<Chart_QtyAtRisk Opportunities="FilteredOpportunities" />
	</div>

	<div class="grid">
		<Chart_TimeTracking ChartType="LastBusinessWeek" Title="Last Week" MaxXValue=35 ReferenceLineValue=10  />
		<Chart_TimeTracking ChartType="ThisWeek" Title="This Week" MaxXValue=35 ReferenceLineValue=10  />
		<Chart_TimeTracking ChartType="ProjectedNextWeek" Title="Projected Next Week" MaxXValue=35 ReferenceLineValue=10 />
	</div>
	
	<div class="grid">
		<Chart_OppStage @key="StageChartKey" Opportunities="FilteredOpportunities" />
		<Chart_TimeTracking ChartType="LastMonth" Title="Last Month" />
	</div>

	<div class="grid">
		<Chart_UpcomingEvents />
	</div>
}

@code {
	private readonly List<OppView> _opportunities = new();
	private const string CloseQuartersStorageKey = "opp-kanban:close-quarters";
	private string[] _selectedCloseQuarters = Array.Empty<string>();
	private int _chartsRenderVersion;
	private bool _isLoading = true;
	private string _errorMessage = string.Empty;
	private string StageChartKey => $"stage-{_chartsRenderVersion}";
	private string OwnershipChartKey(bool excludeClosed) => $"ownership-{excludeClosed}-{_chartsRenderVersion}";
	private string WinLossChartKey => $"winloss-{_chartsRenderVersion}";

	private IEnumerable<string> CloseQuarters => _opportunities
		.Select(opportunity => FiscalQuarterHelper.GetQuarterKey(opportunity.OppDetails.CloseDate, AppConfig.FiscalYearStart))
		.Distinct(StringComparer.Ordinal)
		.OrderByDescending(value => value);

	private IEnumerable<OppView> FilteredOpportunities => _selectedCloseQuarters.Length == 0
		? _opportunities
		: _opportunities.Where(opportunity => _selectedCloseQuarters.Contains(
			FiscalQuarterHelper.GetQuarterKey(opportunity.OppDetails.CloseDate, AppConfig.FiscalYearStart), StringComparer.Ordinal));

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		var storedCloseQuarters = await JS.InvokeAsync<string[]?>("oppFilterStorage.getCloseQuarters", CloseQuartersStorageKey);
		if (storedCloseQuarters is not null)
		{
			_selectedCloseQuarters = storedCloseQuarters;
			_chartsRenderVersion++;
		}

		StateHasChanged();
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var opportunities = await OppCollection
				.Find(FilterDefinition<OppView>.Empty)
				.ToListAsync();

			_opportunities.AddRange(opportunities);
		}
		catch (Exception ex)
		{
			_errorMessage = $"Unable to load analytics: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task PersistCloseQuartersAsync()
	{
		await JS.InvokeVoidAsync("oppFilterStorage.setCloseQuarters", CloseQuartersStorageKey, _selectedCloseQuarters);
	}

	private async Task HandleCloseQuartersChangedAsync(string[] selectedQuarters)
	{
		_selectedCloseQuarters = selectedQuarters;
		_chartsRenderVersion++;
		await PersistCloseQuartersAsync();
	}
}