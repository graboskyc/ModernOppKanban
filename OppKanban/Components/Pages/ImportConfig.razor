@page "/Config"
@rendermode InteractiveServer
@using OppKanban.Datamodels
@using MongoDB.Driver
@inject IConfigSettings ConfigSettings
@inject IMongoCollection<ConfigSettings> ConfigCollection

<PageTitle>Config Settings</PageTitle>

<h1>Config Settings</h1>

<EditForm Model="_draft" OnValidSubmit="SaveAsync">
    <div>
        <label for="sfdc-link">Salesforce link</label>
        <InputText id="sfdc-link" type="url" @bind-Value="_draft.SFDCLink" />
    </div>
    <div>
        <label for="fiscal-year-start">Fiscal year start</label>
        <InputDate id="fiscal-year-start" @bind-Value="_fiscalYearStartDate" DateFormat="MM-dd" />
        <small>Stored as the fiscal year start month/day, defaulting to <code>feb1</code>.</small>
    </div>
    <div>
        <label for="tracked-email-domains">Tracked email domains</label>
        <InputTextArea id="tracked-email-domains" @bind-Value="_trackedEmailDomainsText" />
        <small>Enter one email domain per line, such as <code>example.com</code>.</small>
    </div>
    <h2>Sales stages</h2>
    @foreach (var stage in _draft.SalesStages)
    {
        <details>
            <summary role="button">@stage.StageName <small><i>(click to toggle)</i></small></summary>
            <article data-theme="light">
                <label>
                    Stage name
                    <InputText @bind-Value="stage.StageName" />
                </label>
                <label>
                    Description
                    <InputText @bind-Value="stage.StageDescription" />
                </label>
                <fieldset>
                    <legend>Stage type</legend>
                    <InputCheckbox @bind-Value="stage.IsRenewalStage" /> <label>Renewal stage</label>
                    <InputCheckbox @bind-Value="stage.IsValidationStage" /> <label>Validation stage</label>
                    <InputCheckbox @bind-Value="stage.IsWonStage" /> <label>Won stage</label>
                    <InputCheckbox @bind-Value="stage.IsClosedLostStage" /> <label>Closed-lost stage</label>
                </fieldset>
                <button type="button" class="secondary" @onclick="() => RemoveStage(stage)">Remove stage</button>
            </article>
        </details>
    }
    <button type="button" class="secondary" @onclick="AddStage">Add stage</button>
    <p>Last edited: @_draft.LastEditTime.ToLocalTime().ToString("g")</p>
    <button type="submit" disabled="@_isSaving">
        @(_isSaving ? "Saving..." : "Save")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p class="@_statusClass">@_statusMessage</p>
}

@code {
    private readonly ConfigSettings _draft = new();
    private DateTime _fiscalYearStartDate = new DateTime(2024, 2, 1);
    private string _trackedEmailDomainsText = string.Empty;
    private bool _isSaving;
    private string _statusMessage = string.Empty;
    private string _statusClass = string.Empty;

    protected override void OnInitialized()
    {
        _draft.SFDCLink = ConfigSettings.SFDCLink;
        _draft.FiscalYearStart = ConfigSettings.FiscalYearStart;
        _draft.TrackedEmailDomains = ConfigSettings.TrackedEmailDomains
            .ToList();
        _trackedEmailDomainsText = string.Join(Environment.NewLine, _draft.TrackedEmailDomains);
        _fiscalYearStartDate = FiscalQuarterHelper.ParseFiscalYearStart(_draft.FiscalYearStart);
        _draft.SalesStages = ConfigSettings.SalesStages
            .Select(stage => new ConfigSettingSalesStage
            {
                StageName = stage.StageName,
                StageDescription = stage.StageDescription,
                IsRenewalStage = stage.IsRenewalStage,
                IsClosedLostStage = stage.IsClosedLostStage,
                IsWonStage = stage.IsWonStage,
                IsValidationStage = stage.IsValidationStage
            })
            .ToList();
        _draft.LastEditTime = ConfigSettings.LastEditTime;
    }

    private void AddStage() => _draft.SalesStages.Add(new ConfigSettingSalesStage());

    private void RemoveStage(ConfigSettingSalesStage stage) => _draft.SalesStages.Remove(stage);

    private async Task SaveAsync()
    {
        _statusMessage = string.Empty;
        _statusClass = string.Empty;

        var stageNames = _draft.SalesStages
            .Select(stage => stage.StageName.Trim())
            .ToList();
        if (stageNames.Any(string.IsNullOrWhiteSpace)
            || stageNames.Distinct(StringComparer.OrdinalIgnoreCase).Count() != stageNames.Count)
        {
            _statusMessage = "Every stage must have a unique, non-empty name.";
            _statusClass = "text-danger";
            return;
        }

        var trackedEmailDomains = _trackedEmailDomainsText
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(domain => domain.ToLowerInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (trackedEmailDomains.Any(domain => Uri.CheckHostName(domain) != UriHostNameType.Dns))
        {
            _statusMessage = "Enter valid email domains, one domain per line.";
            _statusClass = "text-danger";
            return;
        }

        _draft.TrackedEmailDomains = trackedEmailDomains;

        _isSaving = true;
        try
        {
            var fiscalYearStartMonth = _fiscalYearStartDate.Month;
            var fiscalYearStartDay = _fiscalYearStartDate.Day;
            var fiscalYearStartText = fiscalYearStartMonth switch
            {
                1 => "jan",
                2 => "feb",
                3 => "mar",
                4 => "apr",
                5 => "may",
                6 => "jun",
                7 => "jul",
                8 => "aug",
                9 => "sep",
                10 => "oct",
                11 => "nov",
                12 => "dec",
                _ => "feb"
            };

            _draft.FiscalYearStart = $"{fiscalYearStartText}{fiscalYearStartDay}";
            _draft.LastEditTime = DateTime.UtcNow;
            await ConfigCollection.InsertOneAsync(_draft);

            ConfigSettings.SFDCLink = _draft.SFDCLink;
            ConfigSettings.FiscalYearStart = _draft.FiscalYearStart;
            ConfigSettings.TrackedEmailDomains = _draft.TrackedEmailDomains;
            ConfigSettings.SalesStages = _draft.SalesStages;
            ConfigSettings.LastEditTime = _draft.LastEditTime;

            _statusMessage = "Configuration saved successfully.";
            _statusClass = "text-success";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Unable to save configuration: {ex.Message}";
            _statusClass = "text-danger";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
