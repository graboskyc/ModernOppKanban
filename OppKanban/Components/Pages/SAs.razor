@page "/SAs"
@rendermode InteractiveServer
@using MongoDB.Driver
@using OppKanban.Datamodels
@using Microsoft.FluentUI.AspNetCore.Components
@inject IMongoCollection<SA> SACollection

<PageTitle>SAs</PageTitle>

<h1>Solutions Architects</h1>
<button type="button" @onclick="OpenCreateModal">New SA</button>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="text-danger">@_errorMessage</p>
}
else if (_isLoading)
{
    <p>Loading SAs...</p>
}
else if (_sas.Count == 0)
{
    <p>No SAs found.</p>
}
else
{
    <div style="overflow-x: auto;">
        @if (ActiveSAs.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Title</th>
                        <th>Info</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sa in ActiveSAs)
                    {
                        <tr>
                            <td><SAProfileImage SAId="@sa.Id" AltText="@sa.Name" /></td>
                            <td>
                                <span>@sa.Name</span>
                                @if (IsStartDateCelebrationPeriod(sa))
                                {
                                    <span title="Anniversary Date: @sa.HireDate.ToShortDateString()"> 🎉</span>
                                }
                            </td>
                            <td>@sa.Title</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(sa.LinkToOneOnOneDoc) && Uri.IsWellFormedUriString(sa.LinkToOneOnOneDoc, UriKind.Absolute))
                                {
                                    <a href="@sa.LinkToOneOnOneDoc" target="_blank" role="button">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.DocumentOnePage())" />
                                    </a>
                                }
                                <button type="button" aria-label="Edit @sa.Name" title="Edit @sa.Name" @onclick="() => OpenEditModal(sa)">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.Edit())" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No active SAs.</p>
        }

        @if (ArchivedSAs.Any())
        {
            <Accordion Title="Archived SAs">
                <table>
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Title</th>
                            <th>Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sa in ArchivedSAs)
                        {
                            <tr>
                                <td><SAProfileImage SAId="@sa.Id" AltText="@sa.Name" /></td>
                                <td>
                                    <span>@sa.Name</span>
                                    @if (IsStartDateCelebrationPeriod(sa))
                                    {
                                        <span title="Anniversary Date: @sa.HireDate.ToShortDateString()"> 🎉</span>
                                    }
                                </td>
                                <td>@sa.Title</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(sa.LinkToOneOnOneDoc) && Uri.IsWellFormedUriString(sa.LinkToOneOnOneDoc, UriKind.Absolute))
                                    {
                                        <a href="@sa.LinkToOneOnOneDoc" target="_blank" role="button">
                                            <FluentIcon Value="@(new Icons.Regular.Size20.DocumentOnePage())" />
                                        </a>
                                    }
                                    <button type="button" aria-label="Edit @sa.Name" title="Edit @sa.Name" @onclick="() => OpenEditModal(sa)">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Edit())" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Accordion>
        }
    </div>
}

<SAEditModal SA="_selectedSA" IsNew="_isCreatingSA" OnClose="CloseEditModal" OnSaved="HandleSavedSA" />

@code {
    private readonly List<SA> _sas = new();
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;
    private SA? _selectedSA;
    private bool _isCreatingSA;

    private IEnumerable<SA> ActiveSAs => _sas.Where(sa => !sa.IsArchived);
    private IEnumerable<SA> ArchivedSAs => _sas.Where(sa => sa.IsArchived);

    protected override async Task OnInitializedAsync()
    {
        await LoadSAsAsync();
    }

    private async Task LoadSAsAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            var sas = await SACollection
                .Find(FilterDefinition<SA>.Empty)
                .SortBy(sa => sa.Name)
                .ToListAsync();

            _sas.Clear();
            _sas.AddRange(sas);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load SAs: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal(SA sa)
    {
        _isCreatingSA = false;
        _selectedSA = sa;
    }

    private void OpenCreateModal()
    {
        _isCreatingSA = true;
        _selectedSA = new SA();
    }

    private void CloseEditModal()
    {
        _selectedSA = null;
        _isCreatingSA = false;
    }

    private async Task HandleSavedSA(SA savedSA)
    {
        await LoadSAsAsync();
        _selectedSA = null;
        _isCreatingSA = false;
    }

    private static bool IsStartDateCelebrationPeriod(SA sa)
    {
        var today = DateTime.Today;
        var startDate = sa.HireDate;

        for (var year = today.Year - 1; year <= today.Year + 1; year++)
        {
            var anniversary = new DateTime(
                year,
                startDate.Month,
                Math.Min(startDate.Day, DateTime.DaysInMonth(year, startDate.Month)));

            if (today >= anniversary.AddDays(-14) && today <= anniversary.AddDays(7))
            {
                return true;
            }
        }

        return false;
    }
}