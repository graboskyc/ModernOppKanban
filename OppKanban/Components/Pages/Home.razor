@page "/"
@page "/Home"
@layout Layout.FullWidthLayout
@using Microsoft.AspNetCore.Components.Web
@using OppKanban.Datamodels
@using OppKanban.Components.Shared
@using MongoDB.Driver
@inject IMongoCollection<OppView> OppCollection
@inject IMongoCollection<OppBase> OppsCollection
@inject IJSRuntime JS
@inject IConfigSettings AppConfig
@using Microsoft.FluentUI.AspNetCore.Components;

<PageTitle>Opportunities</PageTitle>

<h1>Opportunities</h1>

<div class="kanban-page-header">
	@if(!_showOnlyValidation) {
		<div class="stack-vertical">
			@if(_showClosedStages)
			{
				<button class="closed-stages-toggle secondary" type="button" aria-pressed="@(!_showClosedStages)" @onclick="ToggleClosedStages">
					Hide closed stages
				</button>
			} else
			{
				<button class="closed-stages-toggle" type="button" aria-pressed="@(!_showClosedStages)" @onclick="ToggleClosedStages">
					Show closed stages
				</button>
			}

			@if(_showRenewalStages)
			{
				<button class="closed-stages-toggle secondary" type="button" aria-pressed="@(!_showRenewalStages)" @onclick="ToggleRenewalStages">
					Hide renewals
				</button>
			} else
			{
				<button class="closed-stages-toggle" type="button" aria-pressed="@(!_showRenewalStages)" @onclick="ToggleRenewalStages">
					Show renewals
				</button>
			}				

		</div>
	}
	<div class="stack-vertical">
		@if(_showOnlyValidation)
		{
			<button class="closed-stages-toggle secondary" type="button" aria-pressed="@_showOnlyValidation" @onclick="ToggleValidationOnly">
				Show all stages
			</button>
		} else
		{
			<button class="closed-stages-toggle" type="button" aria-pressed="@_showOnlyValidation" @onclick="ToggleValidationOnly">
				Show only validation
			</button>
		}

		@if(_showOnlyStarred)
		{
			<button class="closed-stages-toggle secondary" type="button" aria-pressed="@_showOnlyStarred" @onclick="ToggleStarredOnly">
				Show all star status
			</button>
		} else
		{
			<button class="closed-stages-toggle" type="button" aria-pressed="@_showOnlyStarred" @onclick="ToggleStarredOnly">
				Show only starred
			</button>
		}
	</div>

	<OpportunitySearch OnOpportunitySelected="HandleOpportunitySelectedAsync" Width="65%" />

	<div class="stack-vertical">
		<CloseYearFilter Quarters="CloseQuarters" SelectedQuarters="_selectedCloseQuarters" SelectedQuartersChanged="HandleCloseQuartersChangedAsync" />
		<SAFilter SAs="SalesArchitects" SelectedSAs="_selectedSAs" SelectedSAsChanged="HandleSAsChangedAsync" />
	</div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
	<p class="text-danger">@_errorMessage</p>
}
else if (_isLoading)
{
	<p>Loading opportunities...</p>
}
else if (_opps.Count == 0)
{
	<p>No opportunities found.</p>
}
else
{
	<div class="kanban-board @(_showOnlyValidation ? "validation-only" : string.Empty)" aria-label="Opportunity pipeline">
		@foreach (var stage in VisibleStages)
		{
			var stageOpps = FilteredOpps.Where(opp => StageHelper.IsSameStage(opp.GetStageName(), stage)).ToList();
			<div class="kanban-lane" @ondragover="HandleDragOver" @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="() => MoveOpportunityAsync(stage)">
				<header class="kanban-lane-header">
					<div>
						<h2>@StageHelper.GetStageName(stage)</h2>
						<small>@StageHelper.GetStageDescription(stage)</small>
					</div>
					<span class="kanban-count">@stageOpps.Count</span>
				</header>

				<div class="kanban-cards">
					@foreach (var opp in stageOpps)
					{
						<article class="opportunity-card @(IsHighlighted(opp) ? "opportunity-card-highlighted" : string.Empty)" draggable="true" @ondragstart="() => StartDragging(opp)" @ondragend="ClearDragging">
							<div class="opportunity-card-heading">
								<div>
									<h3>
										@if(opp.OppMetadata?.IsStarred == true)
										{
											<FluentIcon Value="@(new Icons.Regular.Size20.Star())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
										}
										<spaan>@opp.OppDetails.OppName</spaan>										
									</h3>
									<h6 class="account-name">@opp.OppDetails.AccountName</h6>
								</div>
								<button class="metadata-button" aria-label="Open metadata for @opp.OppDetails.OppName" title="Open metadata" @onclick="() => HandleOpportunitySelectedAsync(opp.OppDetails)">
									@if (opp.OppMetadata is not null)
									{
										<FluentIcon Value="@(new Icons.Regular.Size20.Open())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
									}
									else
									{
										<FluentIcon Value="@(new Icons.Regular.Size20.OpenOff())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
									}
								</button>
							</div>

							<div class="grid" style="margin-bottom:.9rem">
								<div class="opportunity-people">
									<span><FluentIcon Value="@(new Icons.Regular.Size20.PersonMoney())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /> @opp.OppDetails.OpportunityOwnerLastName</span>
									<span><FluentIcon Value="@(new Icons.Regular.Size20.PersonSupport())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /> @opp.OppDetails.PrimarySALastName</span>
									@if (opp.OppMetadata?.Feedback?.Count > 0 || opp.OppMetadata?.TechnicalChampions?.Count > 0)
									{
										<span>
											@if (opp.OppMetadata?.Feedback?.Count > 0)
											{
												<FluentIcon Value="@(new Icons.Regular.Size20.PersonFeedback())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" Title="Has Feedback" />
											}
											@if (opp.OppMetadata?.TechnicalChampions?.Count > 0)
											{
												<FluentIcon Value="@(new Icons.Regular.Size20.PeopleMoney())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" Title="Has Technical Champion" />
											}
										</span>
									}
								</div>
								<div>
									<span class="opportunity-err">@opp.OppDetails.ErrRounded</span>
								</div>
							</div>

							<StageDiagram CurrentStage="@opp.GetStageName()" Width="100%" Height="70px" />

							<footer class="opportunity-card-footer">
								<div class="opportunity-card-footer-row">
									<span>
										<FluentIcon Value="@(new Icons.Regular.Size20.CalendarStar())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
										@opp.OppDetails.CloseDate.ToString("yyyy-MM-dd")
									</span>
									<span>@((DateTime.Now - opp.OppDetails.CreatedDate).Days)d old</span>
								</div>
								<div class="opportunity-card-footer-row opportunity-irr">
									<span>IRR</span>
									<span>@opp.OppDetails.Irr.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
								</div>
							</footer>
						</article>
					}
					@if (stageOpps.Count == 0)
					{
						<div class="empty-lane">No opportunities</div>
					}
				</div>
			</div>
		}
	</div>
}

@if (_isMetadataModalOpen)
{
	<OppMetadataModal Opportunity="_selectedOpp" OnClose="CloseMetadataModal" OnToast="ShowToast" OnSaved="HandleMetadataSaved" />
}

@if (_isSearchResultModalOpen)
{
	<OppDetailsModal Opportunity="_selectedSearchOpp" OnClose="CloseSearchResultModal" OnEdit="EditSelectedOpportunityAsync" OnToast="ShowToast" />
}

<Toast Message="@_statusMessage" Show="_showToast">
	<FluentIcon Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.Save())" />
</Toast>

@code {
	private readonly List<OppView> _opps = new();
	private const string ShowClosedStagesStorageKey = "opp-kanban:show-closed-stages";
	private const string ShowRenewalStagesStorageKey = "opp-kanban:show-renewal-stages";
	private const string ShowStarredOnlyStorageKey = "opp-kanban:show-starred-only";
	private const string CloseQuartersStorageKey = "opp-kanban:close-quarters";
	private const string SalesArchitectsStorageKey = "opp-kanban:sales-architects";
	private bool _showClosedStages = true;
	private bool _showRenewalStages = true;
	private bool _showOnlyValidation;
	private bool _showOnlyStarred;
	private string[] _selectedCloseQuarters = Array.Empty<string>();
	private string[] _selectedSAs = Array.Empty<string>();
	private OppBase? _selectedOpp;
	private bool _isLoading = true;
	private bool _isMetadataModalOpen;
	private string _errorMessage = string.Empty;
	private string _statusMessage = string.Empty;
	private bool _showToast;
	private OppView? _draggedOpp;
	private string? _draggedFromStage;
	private OppView? _selectedSearchOpp;
	private bool _isSearchResultModalOpen;
	private string? _highlightedOppId;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		var storedValue = await JS.InvokeAsync<string?>("oppFilterStorage.getValue", ShowClosedStagesStorageKey);
		if (bool.TryParse(storedValue, out var showClosedStages))
		{
			_showClosedStages = showClosedStages;
		}

		var storedRenewalValue = await JS.InvokeAsync<string?>("oppFilterStorage.getValue", ShowRenewalStagesStorageKey);
		if (bool.TryParse(storedRenewalValue, out var showRenewalStages))
		{
			_showRenewalStages = showRenewalStages;
		}

		var storedStarredValue = await JS.InvokeAsync<string?>("oppFilterStorage.getValue", ShowStarredOnlyStorageKey);
		if (bool.TryParse(storedStarredValue, out var showOnlyStarred))
		{
			_showOnlyStarred = showOnlyStarred;
		}

		var storedCloseQuarters = await JS.InvokeAsync<string[]?>("oppFilterStorage.getCloseQuarters", CloseQuartersStorageKey);
		if (storedCloseQuarters is not null)
		{
			_selectedCloseQuarters = storedCloseQuarters;
		}

		var storedSAs = await JS.InvokeAsync<string[]?>("oppFilterStorage.getValue", SalesArchitectsStorageKey);
		if (storedSAs is not null)
		{
			_selectedSAs = storedSAs;
		}

		StateHasChanged();
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var items = await OppCollection
				.Find(FilterDefinition<OppView>.Empty)
				.SortByDescending(x => x.OppDetails.CreatedDate)
				.ToListAsync();

			_opps.AddRange(items);
		}
		catch (Exception ex)
		{
			_errorMessage = $"Unable to load opportunities: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private bool IsHighlighted(OppView opp) =>
		(_isMetadataModalOpen || _isSearchResultModalOpen)
		&& _highlightedOppId is not null
		&& opp.OppDetails.Id == _highlightedOppId;

	private void OpenMetadataModalAsync(OppView opp)
	{
		_selectedOpp = opp.OppDetails;
		_highlightedOppId = opp.OppDetails.Id;
		_isMetadataModalOpen = true;
	}

	private void CloseMetadataModal()
	{
		_isMetadataModalOpen = false;
		_selectedOpp = null;
		_highlightedOppId = null;
	}

	private async Task HandleOpportunitySelectedAsync(OppBase opp)
	{
		var view = _opps.FirstOrDefault(x => x.OppDetails.Id == opp.Id);
		if (view is null)
		{
			try
			{
				view = await OppCollection.Find(x => x.OppDetails.Id == opp.Id).FirstOrDefaultAsync();
			}
			catch (Exception ex)
			{
				ShowToast($"Unable to load opportunity: {ex.Message}");
				return;
			}
		}

		if (view is null)
		{
			ShowToast("Opportunity not found.");
			return;
		}

		_selectedSearchOpp = view;
		_highlightedOppId = view.OppDetails.Id;
		_isSearchResultModalOpen = true;
	}

	private void CloseSearchResultModal()
	{
		_isSearchResultModalOpen = false;
		_selectedSearchOpp = null;
		_highlightedOppId = null;
	}

	private Task EditSelectedOpportunityAsync()
	{
		if (_selectedSearchOpp is not null)
		{
			_selectedOpp = _selectedSearchOpp.OppDetails;
			_isSearchResultModalOpen = false;
			_isMetadataModalOpen = true;
		}

		return Task.CompletedTask;
	}

	private void HandleMetadataSaved(OppMetadata metadata)
	{
		if (_selectedOpp is null)
		{
			return;
		}

		foreach (var opp in _opps.Where(x => x.OppDetails.Id == _selectedOpp.Id))
		{
			opp.OppMetadata = metadata;
		}

		if (_selectedSearchOpp?.OppDetails.Id == _selectedOpp.Id)
		{
			_selectedSearchOpp.OppMetadata = metadata;
		}
	}

	private void ShowToast(string message)
	{
		_statusMessage = message;
		_showToast = true;
	}

	private void StartDragging(OppView opp)
	{
		_draggedOpp = opp;
		_draggedFromStage = opp.GetStageName();
	}

	private void ClearDragging()
	{
		_draggedOpp = null;
		_draggedFromStage = null;
	}

	private void HandleDragOver(DragEventArgs _)
	{
	}

	private async Task MoveOpportunityAsync(ConfigSettingSalesStage targetStage)
	{
		if (_draggedOpp is null || _draggedFromStage is null || StageHelper.IsSameStage(_draggedFromStage, targetStage))
		{
			ClearDragging();
			return;
		}

		var opportunity = _draggedOpp;
		var previousStatus = opportunity.OppDetails.Status;
		opportunity.OppDetails.Status = targetStage.StageName;
		ClearDragging();

		try
		{
			var filter = Builders<OppBase>.Filter.Eq(x => x.Id, opportunity.Id);
			var update = Builders<OppBase>.Update.Set(x => x.Status, opportunity.OppDetails.Status);
			await OppsCollection.UpdateOneAsync(filter, update);
			ShowToast($"Moved to {StageHelper.GetStageName(targetStage)}.");
		}
		catch (Exception ex)
		{
			opportunity.OppDetails.Status = previousStatus;
			ShowToast($"Unable to move opportunity: {ex.Message}");
		}
	}

	private IReadOnlyList<ConfigSettingSalesStage> VisibleStages
	{
		get
		{
			if (_showOnlyValidation)
			{
				return StageHelper.GetAllStages(AppConfig)
					.Where(stage => stage.IsValidationStage)
					.ToList();
			}

			return StageHelper.GetAllStages(AppConfig)
				.Where(stage => _showClosedStages || !stage.IsWonStage && !stage.IsClosedLostStage)
				.Where(stage => _showRenewalStages || !stage.IsRenewalStage)
				.ToList();
		}
	}

	private IEnumerable<string> CloseQuarters => _opps
		.Select(opp => FiscalQuarterHelper.GetQuarterKey(opp.OppDetails.CloseDate, AppConfig.FiscalYearStart))
		.Distinct(StringComparer.Ordinal)
		.OrderByDescending(value => value);

	private IEnumerable<string> SalesArchitects => _opps
		.Select(opp => opp.OppDetails.PrimarySA)
		.Where(name => !string.IsNullOrWhiteSpace(name))
		.Distinct(StringComparer.Ordinal)
		.OrderBy(name => name, StringComparer.OrdinalIgnoreCase);

	private IEnumerable<OppView> FilteredOpps => _opps.Where(opp =>
		(_selectedCloseQuarters.Length == 0
			|| _selectedCloseQuarters.Contains(FiscalQuarterHelper.GetQuarterKey(opp.OppDetails.CloseDate, AppConfig.FiscalYearStart), StringComparer.Ordinal))
		&& (_selectedSAs.Length == 0
			|| _selectedSAs.Contains(opp.OppDetails.PrimarySA, StringComparer.Ordinal))
		&& (!_showOnlyStarred || opp.OppMetadata?.IsStarred == true));

	private async Task PersistCloseQuartersAsync()
	{
		await JS.InvokeVoidAsync("oppFilterStorage.setCloseQuarters", CloseQuartersStorageKey, _selectedCloseQuarters);
	}

	private async Task HandleCloseQuartersChangedAsync(string[] selectedQuarters)
	{
		_selectedCloseQuarters = selectedQuarters;
		await PersistCloseQuartersAsync();
	}

	private async Task HandleSAsChangedAsync(string[] selectedSAs)
	{
		_selectedSAs = selectedSAs;
		await JS.InvokeVoidAsync("oppFilterStorage.setValue", SalesArchitectsStorageKey, _selectedSAs);
	}

	private async Task ToggleClosedStages()
	{
		_showClosedStages = !_showClosedStages;
		await JS.InvokeVoidAsync("oppFilterStorage.setValue", ShowClosedStagesStorageKey, _showClosedStages.ToString());
	}

	private async Task ToggleRenewalStages()
	{
		_showRenewalStages = !_showRenewalStages;
		await JS.InvokeVoidAsync("oppFilterStorage.setValue", ShowRenewalStagesStorageKey, _showRenewalStages.ToString());
	}

	private async Task ToggleStarredOnly()
	{
		_showOnlyStarred = !_showOnlyStarred;
		await JS.InvokeVoidAsync("oppFilterStorage.setValue", ShowStarredOnlyStorageKey, _showOnlyStarred.ToString());
	}

	private void ToggleValidationOnly()
	{
		_showOnlyValidation = !_showOnlyValidation;
	}
}
