@page "/"
@page "/Home"
@using Microsoft.AspNetCore.Components.Web
@using OppKanban.Datamodels
@using OppKanban.Components.Shared
@using MongoDB.Driver
@inject IMongoCollection<OppView> OppCollection
@using Microsoft.FluentUI.AspNetCore.Components;

<PageTitle>Home</PageTitle>

<h1>Opportunities</h1>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
	<p class="text-danger">@_errorMessage</p>
}
else if (_isLoading)
{
	<p>Loading opportunities...</p>
}
else if (_opps.Count == 0)
{
	<p>No opportunities found.</p>
}
else
{
	<table>
		<thead>
			<tr>
				<th>Name</th>
				<th>Team</th>
				<th>Status</th>
				<th>Close</th>
				<th>Metadata</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var opp in _opps)
			{
				<tr>
					<td>
						<FluentIcon Value="@(new Icons.Regular.Size20.Building())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /> @opp.OppDetails.AccountName <br />
						<FluentIcon Value="@(new Icons.Regular.Size20.ReceiptMoney())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /> @opp.OppDetails.OppName
					</td>
					<td>
						<FluentIcon Value="@(new Icons.Regular.Size20.PersonMoney())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /> @opp.OppDetails.OpportunityOwner <br />
						<FluentIcon Value="@(new Icons.Regular.Size20.PersonSupport())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /> @opp.OppDetails.PrimarySA
					</td>
					<td>
                        @opp.OppDetails.Status
                        <StageDiagram CurrentStage="@opp.GetStageEnum()" Width="300px" Height="100px" />
                    </td>
					<td>
                        @opp.OppDetails.CloseDate.ToString("yyyy-MM-dd") <br />
                        <small style="font-size:small">(age @((DateTime.Now - opp.OppDetails.CreatedDate).Days) days)</small>
                    </td>
					<td>
                        @if(opp.OppMetadata is not null) {
                            <button class="secondary outline" @onclick="() => OpenMetadataModalAsync(opp)">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Open())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
                            </button>

                        } else {
                            <button class="secondary outline" @onclick="() => OpenMetadataModalAsync(opp)">
                                <FluentIcon Value="@(new Icons.Regular.Size20.OpenOff())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
                            </button>
                        }
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@if (_isMetadataModalOpen)
{
	<OppMetadataModal Opportunity="_selectedOpp" OnClose="CloseMetadataModal" OnToast="ShowToast" />
}

<Toast Message="@_statusMessage" Show="_showToast">
	<FluentIcon Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.CheckboxPerson())" />
</Toast>

@code {
	private readonly List<OppView> _opps = new();
	private OppBase? _selectedOpp;
	private bool _isLoading = true;
	private bool _isMetadataModalOpen;
	private string _errorMessage = string.Empty;
	private string _statusMessage = string.Empty;
	private bool _showToast;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var items = await OppCollection
				.Find(FilterDefinition<OppView>.Empty)
				.SortByDescending(x => x.OppDetails.CreatedDate)
				.ToListAsync();

			_opps.AddRange(items);
		}
		catch (Exception ex)
		{
			_errorMessage = $"Unable to load opportunities: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private void OpenMetadataModalAsync(OppView opp)
	{
		_selectedOpp = opp.OppDetails;
		_isMetadataModalOpen = true;
	}

	private void CloseMetadataModal()
	{
		_isMetadataModalOpen = false;
		_selectedOpp = null;
	}

	private void ShowToast(string message)
	{
		_statusMessage = message;
		_showToast = true;
	}
}
