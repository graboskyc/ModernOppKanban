@using System.Linq
@using OppKanban.Datamodels
@using MongoDB.Driver
@inject IMongoCollection<OppMetadata> MetadataCollection;
@using Microsoft.FluentUI.AspNetCore.Components;
@using HeyRed.MarkdownSharp;

@if (Opportunity is not null)
{
	<dialog open @oncancel="HandleModalCancel">
		<article>
			<header>
				<button type="button" aria-label="Close" rel="prev" @onclick="CloseModalAsync"></button>
				<p>
					<strong id="metadata-modal-title">Opportunity Metadata</strong>
				</p>
			</header>

			<p><strong>@Opportunity.OppName</strong><br />@Opportunity.Id</p>

			@if (_isLoading)
			{
				<p>Loading metadata...</p>
			}
			else
			{

				<article>

					<details name="basics">
						<summary>Basics <small><i>(click to toggle)</i></small></summary>
						
						<label for="sa-likelihood">SA likelihood <small>@_metadataDraft.SaLikelihood.ToString("0")%</small></label>
						<input id="sa-likelihood" type="range" min="0" max="100" step="5" @bind="_metadataDraft.SaLikelihood" />

						<label for="sizing-document">Sizing document</label>
						<input id="sizing-document" type="url" placeholder="Sizing document link" @bind="_metadataDraft.SizingLink" @bind:event="oninput" />

						<label for="poc-document">POC document</label>
						<input id="poc-document" type="url" placeholder="POC document link" @bind="_metadataDraft.POCDoc" @bind:event="oninput" />

						<label for="metadata-assets">Assets</label>
						<div role="group">
							<input id="metadata-assets" type="text" placeholder="Asset name" @bind="_newAssetName" @bind:event="oninput" />
							<input type="url" placeholder="Asset link" @bind="_newAssetLink" @bind:event="oninput" />
							<button type="button" @onclick="AddAsset" disabled="@(!CanAddAsset)">
								<FluentIcon Value="@(new Icons.Regular.Size20.AddCircle())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#000000" />
							</button>
						</div>
					</details>

					@if (_metadataDraft.Assets.Count != 0)	{
						<details name="assets">
							<summary>Assets <small><i>(click to toggle)</i></small></summary>
								<table><tbody>
									@foreach (var asset in _metadataDraft.Assets)
									{
										<tr>
											<td><a href="@asset.Link" target="_blank" rel="noopener noreferrer">@asset.Name</a></td>
											<td width="15%">
												<button type="button" class="secondary" style="width:100%;height:100%" @onclick="() => RemoveAsset(asset)">
													<FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#ffffff" />
												</button>
											</td>
										</tr>
									}
								</tbody></table>
						</details>
					}

					<details name="launch-events">
						<summary>Go Live Journey <small><i>(click to toggle)</i></small></summary>

						<label for="event-name">Go Live Journey</label>
						<div role="group">
							<input id="event-name" type="text" placeholder="Event name" @bind="_newEventName" @bind:event="oninput" />
							<input type="date" @bind="_newEventDate" @bind:event="oninput" aria-label="Date" />
							<button type="button" @onclick="AddEvent" disabled="@(!CanAddEvent)">
								<FluentIcon Value="@(new Icons.Regular.Size20.AddCircle())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#000000" />
							</button>
						</div>

						@if (_metadataDraft.Events.Count != 0)
						{
							<table><tbody>
								@foreach (var evt in _metadataDraft.Events.OrderBy(e => e.EventDate))
								{
									<tr>
										<td>@evt.EventName</td>
										<td>@evt.EventDate.ToString("yyyy-MM-dd")</td>
										<td width="15%">
											<button type="button" class="secondary" style="width:100%;height:100%" @onclick="() => RemoveEvent(evt)">
												<FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#ffffff" />
											</button>
										</td>
									</tr>
								}
							</tbody></table>
						}
					</details>

					<details name="technical-champions">
						<summary>Technical Champions <small><i>(click to toggle)</i></small></summary>
				
						<label for="technical-champion-name">Technical Champions</label>
						<div role="group">
							<div class="feedback-lookup">
								<input id="technical-champion-name" type="text" placeholder="Champion name" 
									   autocomplete="off"
									   @bind="_newTechnicalChampionName" 
									   @bind:event="oninput" 
									   @bind:after="OnChampionTextChanged" />
								@if (_filteredChampions.Count != 0)
								{
									<div class="feedback-suggestions" role="listbox" aria-label="Champion suggestions">
										@foreach (var c in _filteredChampions)
										{
											<button type="button" class="secondary" role="option" @onclick="() => SelectChampion(c)">
												<strong>@c.Name</strong>
											</button>
										}
									</div>
								}
							</div>
							<input type="url" placeholder="Champion link" @bind="_newTechnicalChampionLink" @bind:event="oninput" />
							<select aria-label="Technical champion stage" @bind="_newTechnicalChampionStage">
								@foreach (var stage in TechnicalChampionStageHelper.GetAllStages())
								{
									<option value="@stage">@TechnicalChampionStageHelper.GetStageName(stage)</option>
								}
							</select>
							<button type="button" @onclick="AddTechnicalChampion" disabled="@(!CanAddTechnicalChampion)">
								<FluentIcon Value="@(new Icons.Regular.Size20.AddCircle())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#000000" />
							</button>
						</div>

						@if (_metadataDraft.TechnicalChampions.Count != 0)
						{
							<table><tbody>
								@foreach (var champion in _metadataDraft.TechnicalChampions)
								{
									<tr>
										<td><a href="@champion.Link" target="_blank" rel="noopener noreferrer">@champion.Name</a></td>
										<td>@TechnicalChampionStageHelper.GetStageName(champion.Stage)</td>
										<td width="15%">
											<button type="button" class="secondary" style="width:100%;height:100%" @onclick="() => RemoveTechnicalChampion(champion)">
												<FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#ffffff" />
											</button>
										</td>
									</tr>
								}
							</tbody></table>
						}
					</details>

					<details name="meddpicc">
						<summary>MEDDPICC <small><i>(click to toggle)</i></small></summary>
						<table class="table" style="text-align: center;">
							<thead class="thead-dark">
								<tr>
									<th>Metrics</th>
									<th>Economic<br>Buyer</th>
									<th>Decision<br>Criteria</th>
									<th>Decision<br>Process</th>
									<th>Paper<br>Process</th>
									<th>Identify<br>Pain</th>
									<th>Champion</th>
									<th>Competition</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_M, v => _metadataDraft.MEDDPICC.MEDDPICC_M = v, "Metrics")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_E, v => _metadataDraft.MEDDPICC.MEDDPICC_E = v, "Economic Buyer")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_Dc, v => _metadataDraft.MEDDPICC.MEDDPICC_Dc = v, "Decision Criteria")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_Dp, v => _metadataDraft.MEDDPICC.MEDDPICC_Dp = v, "Decision Process")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_P, v => _metadataDraft.MEDDPICC.MEDDPICC_P = v, "Paper Process")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_I, v => _metadataDraft.MEDDPICC.MEDDPICC_I = v, "Identify Pain")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_Ch, v => _metadataDraft.MEDDPICC.MEDDPICC_Ch = v, "Champion")</td>
									<td>@MeddpiccToggle(() => _metadataDraft.MEDDPICC.MEDDPICC_Co, v => _metadataDraft.MEDDPICC.MEDDPICC_Co = v, "Competition")</td>
								</tr>
							</tbody>
						</table>
					</details>

					<details name="feedback">
						<summary>Feedback <small><i>(click to toggle)</i></small></summary>
						<label for="feedback-link">Feedback Item</label>
						<div role="group">
							<div class="feedback-lookup">
								<input id="feedback-id" type="text" placeholder="Feedback ID"
									   autocomplete="off"
									   @bind="_newFeedbackId"
									   @bind:event="oninput"
									   @bind:after="OnFeedbackTextChanged" />
								@if (_filteredFeedback.Count != 0)
								{
									<div class="feedback-suggestions" role="listbox" aria-label="Feedback suggestions">
										@foreach (var fb in _filteredFeedback)
										{
											<button type="button" class="secondary" role="option" @onclick="() => SelectFeedback(fb)">
												<strong>@fb.Id</strong> <small>@fb.Type</small>
											</button>
										}
									</div>
								}
							</div>
							<input id="feedback-link" type="url" placeholder="Feedback link" @bind="_newFeedbackLink" @bind:event="oninput" />
							<select aria-label="Feedback type" @bind="_newFeedbackType">
								@foreach (var type in Enum.GetValues<FeedbackType>())
								{
									<option value="@type">@type</option>
								}
							</select>
							<button type="button" @onclick="AddFeedback" disabled="@(!CanAddFeedback)">
								<FluentIcon Value="@(new Icons.Regular.Size20.AddCircle())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#000000" />
							</button>
						</div>

						@if (_metadataDraft.Feedback.Count != 0)
						{
							<table><tbody>
								@foreach (var fb in _metadataDraft.Feedback)
								{
									<tr>
										<td><a href="@fb.Link" target="_blank" rel="noopener noreferrer">@fb.Id</a></td>
										<td>@fb.Type</td>
										<td width="15%">
											<button type="button" class="secondary" style="width:100%;height:100%" @onclick="() => RemoveFeedback(fb)">
												<FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#ffffff" />
											</button>
										</td>
									</tr>
								}
							</tbody></table>
						}
					</details>

					<details name="notes">
						<summary>Notes <small><i>(click to toggle)</i></small></summary>
					
						<button type="button" class="secondary" @onclick="ToggleNotesPreview">
							@(_isPreviewingNotes ? "Edit" : "Preview")
						</button>
						@if (_isPreviewingNotes)
						{
							<div class="notes-preview">@_notesPreviewMarkup</div>
						}
						else
						{
							<textarea rows="5" @bind="_metadataDraft.MEDDPICC.MEDDPICC_Notes" @bind:event="oninput"></textarea>
						}
					</details>
				</article>

				<footer>
					<button type="button" class="secondary" @onclick="CloseModalAsync">Cancel</button>
					<button type="button" @onclick="() => SaveMetadataAsync(false)" disabled="@_isSaving">
						@(_isSaving ? "Saving..." : "Save")
					</button>
					<button type="button" @onclick="() => SaveMetadataAsync(true)" disabled="@_isSaving">
						@(_isSaving ? "Saving..." : "Save & Close")
					</button>
				</footer>
			}
		</article>
	</dialog>
}

@code {
	private RenderFragment MeddpiccToggle(Func<bool> getter, Action<bool> setter, string label) => __builder =>
	{
		var isChecked = getter();
		<button type="button"
				class="@(isChecked ? "" : "secondary")"
				aria-pressed="@isChecked"
				aria-label="@label"
				title="@label"
				@onclick="() => setter(!getter())">
			@if (isChecked)
			{
				<FluentIcon Value="@(new Icons.Regular.Size20.CheckboxChecked())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
			}
			else
			{
				<FluentIcon Value="@(new Icons.Regular.Size20.CheckboxUnchecked())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#ffffff" />
			}
		</button>
	};

	[Parameter, EditorRequired]
	public OppBase? Opportunity { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	[Parameter]
	public EventCallback<string> OnToast { get; set; }

	[Parameter]
	public EventCallback<OppMetadata> OnSaved { get; set; }

	private OppMetadata _metadataDraft = new();
	private string _newAssetName = string.Empty;
	private string _newAssetLink = string.Empty;
	private string _newTechnicalChampionName = string.Empty;
	private string _newTechnicalChampionLink = string.Empty;
	private TechnicalChampionStage _newTechnicalChampionStage = TechnicalChampionStage.Identify;
	private string _newFeedbackId = string.Empty;
	private string _newFeedbackLink = string.Empty;
	private FeedbackType _newFeedbackType = FeedbackType.NiceToHave;
	private string _newEventName = string.Empty;
	private DateTime _newEventDate = DateTime.Now.Date;
	private bool _isLoading = true;
	private bool _isSaving;
	private bool _isPreviewingNotes;
	private MarkupString _notesPreviewMarkup;
	private string? _loadedOpportunityId;
	private static readonly Markdown _markdown = new();
    private List<FeedbackItem> _allExistingFeedback = new();
    private List<FeedbackItem> _filteredFeedback = new();
    private List<TechnicalChampion> _allExistingChampions = new();
    private List<TechnicalChampion> _filteredChampions = new();

	protected override async Task OnParametersSetAsync()
	{
		if (Opportunity is null)
		{
			return;
		}

		if (_loadedOpportunityId == Opportunity.Id)
		{
			return;
		}

		_isLoading = true;
		_isSaving = false;
		_loadedOpportunityId = Opportunity.Id;
		_metadataDraft = new OppMetadata { OppId = Opportunity.Id };
		_newAssetName = string.Empty;
		_newAssetLink = string.Empty;
		_newTechnicalChampionName = string.Empty;
		_newTechnicalChampionLink = string.Empty;
		_newTechnicalChampionStage = TechnicalChampionStage.Identify;
		_newFeedbackId = string.Empty;
		_newFeedbackLink = string.Empty;
		_newFeedbackType = FeedbackType.NiceToHave;
		_newEventName = string.Empty;
		_isPreviewingNotes = true;

		try
		{
			var metadata = await MetadataCollection
				.Find(x => x.OppId == Opportunity.Id)
				.FirstOrDefaultAsync();
			var feedbackLists = await MetadataCollection
				.Find(Builders<OppMetadata>.Filter.Empty)
				.Project(x => x.Feedback)
				.ToListAsync();
            var championLists = await MetadataCollection
                .Find(Builders<OppMetadata>.Filter.Empty)
                .Project(x => x.TechnicalChampions)
				.ToListAsync();

			_allExistingFeedback = feedbackLists
				.SelectMany(feedback => feedback)
				.Where(feedback => !string.IsNullOrWhiteSpace(feedback.Id))
				.GroupBy(feedback => feedback.Id, StringComparer.OrdinalIgnoreCase)
				.Select(group => group.First())
				.OrderBy(feedback => feedback.Id)
				.ToList();

            _allExistingChampions = championLists
                .SelectMany(champions => champions)
                .Where(c => !string.IsNullOrWhiteSpace(c.Name))
				.GroupBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(c => c.Name)
				.ToList();

			if (metadata is not null)
			{
				_metadataDraft = new OppMetadata
				{
					Id = metadata.Id,
					OppId = metadata.OppId,
					SizingLink = metadata.SizingLink,
					POCDoc = metadata.POCDoc,
					SaLikelihood = metadata.SaLikelihood,
					Assets = metadata.Assets.ToList(),
					TechnicalChampions = metadata.TechnicalChampions.ToList(),
					Feedback = metadata.Feedback.ToList(),
					Events = metadata.Events.ToList(),
					MEDDPICC = metadata.MEDDPICC ?? new MEDDPICC()
				};
			}
		}
		catch (Exception ex)
		{
			await OnToast.InvokeAsync($"Unable to load metadata: {ex.Message}");
		}
		finally
		{
			_isLoading = false;
		}
	}

	private Task HandleModalCancel()
	{
		return CloseModalAsync();
	}

	private async Task CloseModalAsync()
	{
		await OnClose.InvokeAsync();
	}

	private async Task SaveMetadataAsync(bool closeAfterSave = false)
	{
		if (Opportunity is null)
		{
			return;
		}

		_isSaving = true;
		var parsedAssets = _metadataDraft.Assets.ToList();
		var technicalChampions = _metadataDraft.TechnicalChampions.ToList();
		var events = _metadataDraft.Events.ToList();

		try
		{
			var filter = Builders<OppMetadata>.Filter.Eq(x => x.OppId, Opportunity.Id);
			var update = Builders<OppMetadata>.Update
				.Set(x => x.OppId, Opportunity.Id)
				.Set(x => x.SizingLink, _metadataDraft.SizingLink)
				.Set(x => x.POCDoc, _metadataDraft.POCDoc)
				.Set(x => x.SaLikelihood, _metadataDraft.SaLikelihood)
				.Set(x => x.Assets, parsedAssets)
				.Set(x => x.TechnicalChampions, technicalChampions)
				.Set(x => x.Feedback, _metadataDraft.Feedback.ToList())
				.Set(x => x.Events, events)
				.Set(x => x.MEDDPICC, _metadataDraft.MEDDPICC);

			var savedMetadata = await MetadataCollection.FindOneAndUpdateAsync(
				filter,
				update,
				new FindOneAndUpdateOptions<OppMetadata>
				{
					IsUpsert = true,
					ReturnDocument = ReturnDocument.After
				});

			_metadataDraft = savedMetadata;
			await OnToast.InvokeAsync("Metadata saved.");
			await OnSaved.InvokeAsync(savedMetadata);
		}
		catch (Exception ex)
		{
			await OnToast.InvokeAsync($"Unable to save metadata: {ex.Message}");
		}
		finally
		{
			_isSaving = false;
			if (closeAfterSave)
			{
				await CloseModalAsync();
			}
		}
	}

	private void AddAsset()
	{
		var name = _newAssetName.Trim();
		var link = _newAssetLink.Trim();
		if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(link))
		{
			return;
		}

		_metadataDraft.Assets.Add(new OppAsset { Name = name, Link = link });
		_newAssetName = string.Empty;
		_newAssetLink = string.Empty;
	}

	private bool CanAddAsset =>
		!string.IsNullOrWhiteSpace(_newAssetName) &&
		!string.IsNullOrWhiteSpace(_newAssetLink);

	private void RemoveAsset(OppAsset asset)
	{
		_metadataDraft.Assets.Remove(asset);
	}

	private void AddTechnicalChampion()
	{
		var name = _newTechnicalChampionName.Trim();
		var link = _newTechnicalChampionLink.Trim();
		if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(link))
		{
			return;
		}

		_metadataDraft.TechnicalChampions.Add(new TechnicalChampion
		{
			Name = name,
			Link = link,
			Stage = _newTechnicalChampionStage
		});
		_newTechnicalChampionName = string.Empty;
		_newTechnicalChampionLink = string.Empty;
		_newTechnicalChampionStage = TechnicalChampionStage.Identify;
        _filteredChampions = new();
	}

	private bool CanAddTechnicalChampion =>
		!string.IsNullOrWhiteSpace(_newTechnicalChampionName) &&
		!string.IsNullOrWhiteSpace(_newTechnicalChampionLink);

	private void RemoveTechnicalChampion(TechnicalChampion champion)
	{
		_metadataDraft.TechnicalChampions.Remove(champion);
	}

    private void OnChampionTextChanged()
	{
		var searchText = _newTechnicalChampionName.Trim();
		_filteredChampions = searchText.Length < 2
			? new()
			: _allExistingChampions
				.Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
				.Take(8)
				.ToList();
	}

	private void SelectChampion(TechnicalChampion champion)
	{
		_newTechnicalChampionName = champion.Name;
		_newTechnicalChampionLink = champion.Link;
		_newTechnicalChampionStage = champion.Stage;
		_filteredChampions = new();
	}

	private bool CanAddFeedback => !string.IsNullOrWhiteSpace(_newFeedbackId) && !string.IsNullOrWhiteSpace(_newFeedbackLink);

	private void RemoveFeedback(FeedbackItem feedback)
	{
		_metadataDraft.Feedback.Remove(feedback);
	}

    private void AddFeedback()
	{
		var id = _newFeedbackId.Trim();
		var link = _newFeedbackLink.Trim();
		if (string.IsNullOrWhiteSpace(id) || string.IsNullOrWhiteSpace(link))
		{
			return;
		}

		_metadataDraft.Feedback.Add(new FeedbackItem
		{
			Id = id,
			Link = link,
			Type = _newFeedbackType
		});
		_newFeedbackId = string.Empty;
		_newFeedbackLink = string.Empty;
		_newFeedbackType = FeedbackType.NiceToHave;
        _filteredFeedback = new();
	}

	private void OnFeedbackTextChanged()
	{
		var searchText = _newFeedbackId.Trim();
		_filteredFeedback = searchText.Length < 2
			? new()
			: _allExistingFeedback
				.Where(feedback => feedback.Id.Contains(searchText, StringComparison.OrdinalIgnoreCase))
				.Take(8)
				.ToList();
	}

	private void SelectFeedback(FeedbackItem feedback)
	{
		_newFeedbackId = feedback.Id;
		_newFeedbackLink = feedback.Link;
		_newFeedbackType = feedback.Type;
		_filteredFeedback = new();
	}

	private void AddEvent()
	{
		var name = _newEventName.Trim();
		if (string.IsNullOrWhiteSpace(name))
		{
			return;
		}

		_metadataDraft.Events.Add(new EventEntry { EventName = name, EventDate = _newEventDate });
		_newEventName = string.Empty;
		_newEventDate = DateTime.Now.Date;
	}

	private bool CanAddEvent => !string.IsNullOrWhiteSpace(_newEventName);

	private void RemoveEvent(EventEntry evt)
	{
		_metadataDraft.Events.Remove(evt);
	}

	private void ToggleNotesPreview()
	{
		if (!_isPreviewingNotes)
		{
			var notes = _metadataDraft.MEDDPICC.MEDDPICC_Notes;
			_notesPreviewMarkup = string.IsNullOrEmpty(notes)
				? (MarkupString)string.Empty
				: (MarkupString)_markdown.Transform(notes);
		}

		_isPreviewingNotes = !_isPreviewingNotes;
	}
}