@using OppKanban.Datamodels
@using System.Linq
@using Microsoft.FluentUI.AspNetCore.Components;
@using HeyRed.MarkdownSharp;
@using MongoDB.Driver
@inject IConfigSettings AppConfig
@inject IMongoCollection<OppMetadata> MetadataCollection

@if (Opportunity is not null)
{
	<dialog open @oncancel="CloseModalAsync">
		<article class="opportunity-details-modal">
			<header>
				<button type="button" aria-label="Close" rel="prev" @onclick="CloseModalAsync"></button>
				<p>
					<strong>Opportunity Details</strong>&nbsp;
					<button type="button" class="secondary" aria-label="Edit metadata" title="Edit metadata" @onclick="EditOpportunityAsync" style="font-size: 10px;padding: 5px;">Edit</button>
					<a href="@($"{AppConfig.SFDCLink}/lightning/r/Opportunity/{Opportunity.OppDetails.Id}/view")" target="_blank" rel="noopener noreferrer" role="button" class="secondary" aria-label="View in Salesforce" title="View in Salesforce" style="font-size: 10px;padding: 5px;">View in SFDC</a>
				</p>
			</header>

			<h3>Basic Information</h3>
			<table class="striped">
				<tbody>
					<tr>
						<td title="Account Name"><FluentIcon Value="@(new Icons.Regular.Size20.Building())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td>@Opportunity.OppDetails.AccountName</td>
					</tr>
					<tr>
						<td title="Opportunity Name"><FluentIcon Value="@(new Icons.Regular.Size20.ReceiptMoney())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td>
							<button type="button" class="secondary" aria-label="@(IsStarred ? "Unstar opportunity" : "Star opportunity")" title="@(IsStarred ? "Unstar opportunity" : "Star opportunity")" aria-pressed="@IsStarred" disabled="@_isTogglingStar" @onclick="ToggleStarAsync" style="padding: 0.25rem; margin-right: 0.35rem; vertical-align: middle;">
								@if (IsStarred)
								{
									<FluentIcon Value="@(new Icons.Regular.Size20.Star())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
								}
								else
								{
									<FluentIcon Value="@(new Icons.Regular.Size20.StarOff())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" />
								}
							</button>
							<span>@Opportunity.OppDetails.OppName</span>
						</td>
					</tr>
					<tr>
						<td title="Opportunity Owner"><FluentIcon Value="@(new Icons.Regular.Size20.PersonMoney())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td>@Opportunity.OppDetails.OpportunityOwner</td>
					</tr>
					<tr>
						<td title="Primary SA"><FluentIcon Value="@(new Icons.Regular.Size20.PersonSupport())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td>@Opportunity.OppDetails.PrimarySA</td>
					</tr>
					<tr>
						<td title="ERR / IRR"><FluentIcon Value="@(new Icons.Regular.Size20.Money())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td><span style="font-weight: bold;color: #e48500;">ERR:</span> @Opportunity.OppDetails.Err.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")) / <span style="font-weight: bold;color: #e48500;">IRR:</span> @Opportunity.OppDetails.Irr.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
					</tr>
					<tr>
						<td title="Close Date"><FluentIcon Value="@(new Icons.Regular.Size20.CalendarStar())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td>@Opportunity.OppDetails.CloseDate.ToString("yyyy-MM-dd")</td>
					</tr>
					<tr>
						<td title="Created Date"><FluentIcon Value="@(new Icons.Regular.Size20.CalendarError())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td>@((DateTime.Now - Opportunity.OppDetails.CreatedDate).Days)d old</td>
					</tr>
					<tr>
						<td title="Current Stage"><FluentIcon Value="@(new Icons.Regular.Size20.ColumnTriple())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td><StageDiagram CurrentStage="@Opportunity.GetStageName()" Width="100%" Height="90px" /></td>
					</tr>
					@if(!string.IsNullOrEmpty(Opportunity.OppDetails.Notes)) {
						<tr>
							<td title="Notes"><FluentIcon Value="@(new Icons.Regular.Size20.Notepad())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
							<td style="white-space: pre-wrap;">@Opportunity.OppDetails.Notes</td>
						</tr>
					}
					@if (Opportunity.OppMetadata is not null) {
						<tr>
							<td title="SA Likelihood"><FluentIcon Value="@(new Icons.Regular.Size20.DocumentPercent())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
							<td>@Opportunity.OppMetadata.SaLikelihood.ToString("0")%</td>
						</tr>
						<tr>
							<td title="POC Doc"><FluentIcon Value="@(new Icons.Regular.Size20.Document())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
							<td><a href="@Opportunity.OppMetadata.POCDoc" target="_blank" rel="noopener noreferrer">POC Doc</a></td>
						</tr>
						<tr>
							<td title="Sizing Link"><FluentIcon Value="@(new Icons.Regular.Size20.Ruler())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
							<td><a href="@Opportunity.OppMetadata.SizingLink" target="_blank" rel="noopener noreferrer">Sizing Link</a></td>
						</tr>
						<tr>
							<td title="MEDDPICC"><FluentIcon Value="@(new Icons.Regular.Size20.ClipboardCheckmark())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
							<td><MEDDPICCVis MEDDPICC="@Opportunity.OppMetadata.MEDDPICC" /></td>
						</tr>
						<tr>
							<td title="MEDDPICC Notes"><FluentIcon Value="@(new Icons.Regular.Size20.Notepad())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
							<td>@_meddpiccNotesMarkup</td>
						</tr>
					}
					<tr>
						<td><FluentIcon Value="@(new Icons.Regular.Size20.CalendarInfo())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Custom" CustomColor="#e48500" /></td>
						<td><AIMeetingRerank SA="@Opportunity.OppDetails.PrimarySA" MeetingStartTime="@Opportunity.OppDetails.CreatedDate" MeetingEndTime="@DateTime.Now" OpportunityInformationQuery="String.Concat(Opportunity.OppDetails.AccountName, ' - ', Opportunity.OppDetails.OppName)" CutoffScore=0.2f /></td>
					</tr>
				</tbody>
			</table>

			@if (Opportunity.OppMetadata is not null)
			{
				@if (Opportunity.OppMetadata.Assets.Count > 0)
				{
					<h3>Assets</h3>
					<table class="striped"><tbody>
						@foreach (var asset in Opportunity.OppMetadata.Assets)
						{
							<tr>
								<td><a href="@asset.Link" target="_blank" rel="noopener noreferrer">@asset.Name</a></td>
							</tr>
						}
					</tbody></table>
				}

				@if (Opportunity.OppMetadata.TechnicalChampions.Count > 0)
				{
					<h3>Technical Champions</h3>
					<table class="striped"><tbody>
						@foreach (var champion in Opportunity.OppMetadata.TechnicalChampions)
						{
							<tr>
								<td><a href="@champion.Link" target="_blank" rel="noopener noreferrer">@champion.Name</a></td>
								<td>@TechnicalChampionStageHelper.GetStageName(champion.Stage)</td>
							</tr>
						}
					</tbody></table>
				}

				@if (Opportunity.OppMetadata.Events.Count > 0)
				{
					<h3>Go Live Journey</h3>
					<EventsTimeline Events="@Opportunity.OppMetadata.Events" />
				}

				@if (Opportunity.OppMetadata.Feedback.Count > 0)
				{
					<h3>Feedback</h3>
					<table class="striped"><tbody>
						@foreach (var fb in Opportunity.OppMetadata.Feedback)
						{
							<tr>
								<td><a href="@fb.Link" target="_blank" rel="noopener noreferrer">@fb.Id</a> <small>(@fb.Type)</small></td>
							</tr>
						}
					</tbody></table>
				}
			}
		</article>
	</dialog>
}

@code {
	[Parameter, EditorRequired]
	public OppView? Opportunity { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	[Parameter]
	public EventCallback OnEdit { get; set; }

	[Parameter]
	public EventCallback<string> OnToast { get; set; }
	Markdown mark = new Markdown();
	private MarkupString _meddpiccNotesMarkup;
	private bool _isTogglingStar;

	private bool IsStarred => Opportunity?.OppMetadata?.IsStarred == true;

	private async Task CloseModalAsync()
	{
		await OnClose.InvokeAsync();
	}

	private async Task EditOpportunityAsync()
	{
		await OnEdit.InvokeAsync();
	}

	private async Task ToggleStarAsync()
	{
		if (Opportunity is null || _isTogglingStar)
		{
			return;
		}

		_isTogglingStar = true;
		var isStarred = !IsStarred;

		try
		{
			var filter = Builders<OppMetadata>.Filter.Eq(x => x.OppId, Opportunity.OppDetails.Id);
			var update = Builders<OppMetadata>.Update
				.Set(x => x.OppId, Opportunity.OppDetails.Id)
				.Set(x => x.IsStarred, isStarred);
			var metadata = await MetadataCollection.FindOneAndUpdateAsync(
				filter,
				update,
				new FindOneAndUpdateOptions<OppMetadata>
				{
					IsUpsert = true,
					ReturnDocument = ReturnDocument.After
				});

			Opportunity.OppMetadata = metadata;
			await OnToast.InvokeAsync(isStarred ? "Opportunity starred." : "Opportunity unstarred.");
		}
		catch (Exception ex)
		{
			await OnToast.InvokeAsync($"Unable to update star: {ex.Message}");
		}
		finally
		{
			_isTogglingStar = false;
		}
	}

	// on parameter set, if Opportunity is not null and has a MgrNote, convert it to MarkupString
	protected override void OnParametersSet() {
		if (Opportunity?.OppMetadata?.MEDDPICC is not null && !string.IsNullOrEmpty(Opportunity.OppMetadata.MEDDPICC.MEDDPICC_Notes)){
			_meddpiccNotesMarkup = (MarkupString)mark.Transform(Opportunity.OppMetadata.MEDDPICC.MEDDPICC_Notes);
		}
	}
	
}
