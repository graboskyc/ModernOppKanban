@using OppKanban.Datamodels

<div class="close-year-filter">
    @if (_isOpen)
    {
        <button class="close-year-backdrop" type="button" aria-label="Close close quarter filter" @onclick="CloseDropdown"></button>
    }

    <button class="close-year-trigger" type="button" aria-expanded="@_isOpen" aria-haspopup="listbox" @onclick="ToggleOpen">
        <span>@SelectionLabel</span>
        <span class="close-year-caret" aria-hidden="true"></span>
    </button>

    @if (_isOpen)
    {
        <div class="close-year-options" role="group" aria-label="Close quarters">
            <div class="close-year-actions">
                <button class="close-year-action" type="button" @onclick="SelectAllAsync">Select all</button>
                <button class="close-year-action" type="button" @onclick="ClearAllAsync">Clear all</button>
            </div>

            @foreach (var quarter in Quarters.OrderByDescending(quarter => quarter))
            {
                <label>
                    <input type="checkbox"
                           checked="@IsSelected(quarter)"
                           @onchange="() => ToggleQuarter(quarter)" />
                    <span>@FiscalQuarterHelper.GetQuarterLabel(quarter)</span>
                </label>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<string> Quarters { get; set; } = Enumerable.Empty<string>();

    [Parameter]
    public string[] SelectedQuarters { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback<string[]> SelectedQuartersChanged { get; set; }

    private bool _isOpen;

    private string SelectionLabel => SelectedQuarters.Length == 0
        ? "All close quarters"
        : $"{SelectedQuarters.Length} close quarter{(SelectedQuarters.Length == 1 ? string.Empty : "s")} selected";

    private bool IsSelected(string quarter) => SelectedQuarters.Contains(quarter, StringComparer.Ordinal);

    private void ToggleOpen()
    {
        _isOpen = !_isOpen;
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private async Task ToggleQuarter(string quarter)
    {
        var selectedQuarters = SelectedQuarters.ToHashSet(StringComparer.Ordinal);

        if (!selectedQuarters.Add(quarter))
        {
            selectedQuarters.Remove(quarter);
        }

        await SelectedQuartersChanged.InvokeAsync(selectedQuarters.OrderByDescending(value => value).ToArray());
    }

    private async Task SelectAllAsync()
    {
        var selectedQuarters = Quarters
            .Distinct(StringComparer.Ordinal)
            .OrderByDescending(value => value)
            .ToArray();

        await SelectedQuartersChanged.InvokeAsync(selectedQuarters);
    }

    private async Task ClearAllAsync()
    {
        await SelectedQuartersChanged.InvokeAsync(Array.Empty<string>());
    }
}