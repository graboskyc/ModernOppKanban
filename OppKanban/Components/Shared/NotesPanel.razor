@using MongoDB.Driver
@using OppKanban.Datamodels
@using HeyRed.MarkdownSharp
@inject IMongoCollection<NotesDocument> NotesCollection
@inject ILogger<NotesPanel> Logger

<div class="notes-backdrop @(IsOpen ? "is-visible" : string.Empty)" aria-hidden="true" @onclick="CloseAsync"></div>
<aside class="notes-panel @(IsOpen ? "is-open" : string.Empty)"
       role="complementary"
       aria-label="Shared notes"
       aria-hidden="@(!IsOpen)"
       inert="@(!IsOpen)">
    <header class="notes-header">
        <div>
            <h2>Notes</h2>
            <small>Shared workspace notes</small>
        </div>
        <button type="button" class="secondary notes-close" aria-label="Close notes" @onclick="CloseAsync">×</button>
    </header>

    @if (_isLoading)
    {
        <p class="notes-message" role="status">Loading notes…</p>
    }
    else if (_isEditing)
    {
        <textarea @ref="_markdownEditor"
                  class="notes-editor"
                  aria-label="Shared workspace notes in Markdown"
                  placeholder="Write your notes in Markdown..."
                  spellcheck="true"
                  @bind="_contentMarkdown"
                  @bind:event="oninput"></textarea>
    }
    else
    {
        <div class="notes-editor notes-preview"
             role="button"
             tabindex="0"
             aria-label="Edit shared workspace notes"
             @onclick="BeginEditing"
             @onkeydown="HandlePreviewKeyDown">
            @if (string.IsNullOrWhiteSpace(_contentMarkdown))
            {
                <span class="notes-placeholder">Write your notes...</span>
            }
            else
            {
                @((MarkupString)_markdown.Transform(_contentMarkdown))
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="notes-error" role="alert">@_errorMessage</p>
    }

    <footer class="notes-footer">
        <span class="notes-message" role="status">@_statusMessage</span>
        <button type="button" @onclick="SaveAsync" disabled="@(_isLoading || _isSaving)">
            @(_isSaving ? "Saving…" : "Save")
        </button>
    </footer>
</aside>

@code {
    private const string DocumentId = "shared";
    private static readonly Markdown _markdown = new();
    private ElementReference _markdownEditor;
    private string _contentMarkdown = string.Empty;
    private string _statusMessage = string.Empty;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditing;
    private bool _focusEditorAfterRender;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var document = await NotesCollection
                .Find(note => note.Id == DocumentId)
                .FirstOrDefaultAsync();
            _contentMarkdown = document?.ContentMarkdown ?? document?.LegacyContentHtml ?? string.Empty;
        }
        catch (MongoException exception)
        {
            Logger.LogError(exception, "Failed to load shared notes.");
            _errorMessage = "Notes could not be loaded. Check the database connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditorAfterRender)
        {
            return;
        }

        _focusEditorAfterRender = false;
        try
        {
            await _markdownEditor.FocusAsync();
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Failed to focus the shared notes editor.");
            _errorMessage = "The notes editor could not be focused.";
            StateHasChanged();
        }
    }

    private void BeginEditing()
    {
        _isEditing = true;
        _focusEditorAfterRender = true;
    }

    private void HandlePreviewKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            BeginEditing();
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _statusMessage = string.Empty;

        try
        {
            var document = new NotesDocument
            {
                Id = DocumentId,
                ContentMarkdown = _contentMarkdown,
                LastEditTime = DateTime.UtcNow
            };
            await NotesCollection.ReplaceOneAsync(
                note => note.Id == DocumentId,
                document,
                new ReplaceOptions { IsUpsert = true });
            _isEditing = false;
            _statusMessage = $"Saved at {document.LastEditTime.ToLocalTime():t}";
        }
        catch (MongoException exception)
        {
            Logger.LogError(exception, "Failed to save shared notes.");
            _errorMessage = "Notes could not be saved. Check the database connection and try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task CloseAsync() => IsOpenChanged.InvokeAsync(false);
}
