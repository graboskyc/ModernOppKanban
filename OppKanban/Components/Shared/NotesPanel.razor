@using MongoDB.Driver
@using OppKanban.Datamodels
@inject IMongoCollection<NotesDocument> NotesCollection
@inject ILogger<NotesPanel> Logger
@inject IJSRuntime JS

<div class="notes-backdrop @(IsOpen ? "is-visible" : string.Empty)" aria-hidden="true" @onclick="CloseAsync"></div>
<aside class="notes-panel @(IsOpen ? "is-open" : string.Empty)"
       role="complementary"
       aria-label="Shared notes"
       aria-hidden="@(!IsOpen)"
       inert="@(!IsOpen)">
    <header class="notes-header">
        <div>
            <h2>Notes</h2>
            <small>Shared workspace notes</small>
        </div>
        <button type="button" class="secondary notes-close" aria-label="Close notes" @onclick="CloseAsync">×</button>
    </header>

    @if (_isLoading)
    {
        <p class="notes-message" role="status">Loading notes…</p>
    }
    else
    {
        <div class="notes-toolbar" role="toolbar" aria-label="Notes formatting">
            <button type="button" aria-label="Bold" title="Bold" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("bold")'><strong>B</strong></button>
            <button type="button" aria-label="Italic" title="Italic" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("italic")'><em>I</em></button>
            <button type="button" aria-label="Underline" title="Underline" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("underline")'><u>U</u></button>
            <button type="button" aria-label="Heading" title="Heading" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("formatBlock", "h2")'>H</button>
            <button type="button" aria-label="Bulleted list" title="Bulleted list" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("insertUnorderedList")'>• List</button>
            <button type="button" aria-label="Numbered list" title="Numbered list" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("insertOrderedList")'>1. List</button>
            <button type="button" aria-label="Link" title="Link" @onmousedown:preventDefault="true" @onclick="CreateLinkAsync">Link</button>
            <button type="button" aria-label="Clear formatting" title="Clear formatting" @onmousedown:preventDefault="true" @onclick='() => ExecuteCommandAsync("removeFormat")'>Clear</button>
        </div>
        <div id="notes-editor"
             class="notes-editor"
             contenteditable="true"
             role="textbox"
             aria-label="Shared workspace notes"
             aria-multiline="true"
             data-placeholder="Write your notes..."
             spellcheck="true"></div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="notes-error" role="alert">@_errorMessage</p>
    }

    <footer class="notes-footer">
        <span class="notes-message" role="status">@_statusMessage</span>
        <button type="button" @onclick="SaveAsync" disabled="@(_isLoading || _isSaving || !_editorInitialized)">
            @(_isSaving ? "Saving…" : "Save")
        </button>
    </footer>
</aside>

@code {
    private const string DocumentId = "shared";
    private string _contentHtml = string.Empty;
    private string _statusMessage = string.Empty;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _editorInitialized;
    private bool _editorInitializationFailed;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var document = await NotesCollection
                .Find(note => note.Id == DocumentId)
                .FirstOrDefaultAsync();
            _contentHtml = document?.ContentHtml ?? string.Empty;
        }
        catch (MongoException exception)
        {
            Logger.LogError(exception, "Failed to load shared notes.");
            _errorMessage = "Notes could not be loaded. Check the database connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && !_editorInitialized && !_editorInitializationFailed)
        {
            try
            {
                await JS.InvokeVoidAsync("notesPanel.setHtml", "notes-editor", _contentHtml);
                _editorInitialized = true;
            }
            catch (JSException exception)
            {
                Logger.LogError(exception, "Failed to initialize the notes editor.");
                _editorInitializationFailed = true;
                _errorMessage = "The notes editor could not be initialized. Try reloading the page.";
                StateHasChanged();
            }
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _statusMessage = string.Empty;

        try
        {
            _contentHtml = await JS.InvokeAsync<string>("notesPanel.getHtml", "notes-editor");
            var document = new NotesDocument
            {
                Id = DocumentId,
                ContentHtml = _contentHtml,
                LastEditTime = DateTime.UtcNow
            };
            await NotesCollection.ReplaceOneAsync(
                note => note.Id == DocumentId,
                document,
                new ReplaceOptions { IsUpsert = true });
            _statusMessage = $"Saved at {document.LastEditTime.ToLocalTime():t}";
        }
        catch (MongoException exception)
        {
            Logger.LogError(exception, "Failed to save shared notes.");
            _errorMessage = "Notes could not be saved. Check the database connection and try again.";
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Failed to read the notes editor contents.");
            _errorMessage = "Notes could not be read from the editor. Try reloading the page.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ExecuteCommandAsync(string command, string? value = null)
    {
        try
        {
            await JS.InvokeVoidAsync("notesPanel.executeCommand", command, value);
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Failed to format the shared notes.");
            _errorMessage = "The notes could not be formatted. Try reloading the page.";
        }
    }

    private async Task CreateLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("notesPanel.createLink");
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Failed to add a link to the shared notes.");
            _errorMessage = "A link could not be added to the notes.";
        }
    }

    private Task CloseAsync() => IsOpenChanged.InvokeAsync(false);
}