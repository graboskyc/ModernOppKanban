@using OppKanban.Datamodels
@using System.Collections.Generic
@using System.Linq

<div class="stage-diagram-container" style="width: @Width; height: @Height;">
    <svg class="stage-diagram" viewBox="0 50 @GetViewBoxWidth() 150" preserveAspectRatio="xMinYMin meet">
        <!-- Draw connecting lines between stages -->
        @for (int i = 0; i < DiagramStages.Count - 1; i++)
        {
            var x1 = GetCircleX(i) + 25;
            var x2 = GetCircleX(i + 1) - 25;
            <line x1="@x1" y1="75" x2="@x2" y2="75" class="stage-line" />
        }

        <!-- Draw circles for each stage -->
        @for (int i = 0; i < DiagramStages.Count; i++)
        {
            var stage = DiagramStages[i];
            var isTerminalStage = stage == OpportunityStage.ClosedWon;
            var isCurrentStage = stage == CurrentStage ||
                (isTerminalStage && (CurrentStage == OpportunityStage.ClosedWon || CurrentStage == OpportunityStage.ClosedLost));
            var isFutureStage = !isCurrentStage && AllStages.IndexOf(stage) > AllStages.IndexOf(CurrentStage);
            var x = GetCircleX(i);
            var terminalClass = isCurrentStage && isTerminalStage
                ? (CurrentStage == OpportunityStage.ClosedWon ? "closed-won" : "closed-lost")
                : "";
            
            <circle 
                cx="@x" 
                cy="75" 
                r="@(isCurrentStage ? 22 : 18)" 
                class="stage-circle @(isCurrentStage ? "active" : "") @(isFutureStage ? "future" : "") @terminalClass"
                title="@(isTerminalStage ? StageHelper.GetStageName(CurrentStage) : StageHelper.GetStageName(stage))" />
        }
    </svg>
</div>

@code {
    [Parameter]
    public OpportunityStage CurrentStage { get; set; } = OpportunityStage.Discovery;

    [Parameter]
    public string Width { get; set; } = "100%";

    [Parameter]
    public string Height { get; set; } = "auto";

    private List<OpportunityStage> AllStages = new();

    private List<OpportunityStage> DiagramStages = new();

    protected override void OnInitialized()
    {
        AllStages = StageHelper.GetAllStages();
        DiagramStages = AllStages.Take(AllStages.Count - 1).ToList();
    }

    private double GetCircleX(int index)
    {
        if (DiagramStages.Count <= 1) return 50;
        
        double spacing = (GetViewBoxWidth() - 50) / (DiagramStages.Count - 1);
        return 25 + (index * spacing);
    }

    private int GetViewBoxWidth()
    {
        return Math.Max(300, DiagramStages.Count() * 70);
    }
}

