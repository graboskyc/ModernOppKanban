
@inherits ComponentBase

<details open="@IsExpanded">
    <summary role="button">@Title <small><i>click to toggle</i></small></summary>
    <div class="accordion-content">
        @ChildContent
    </div>
</details>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
}

@code {
    [Parameter]
    public string Title { get; set; } = "More Information";
}

@code {
    [Parameter]
    public bool IsExpanded { get; set; } = false;
}